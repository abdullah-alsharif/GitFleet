# GitHub token (classic: read:org + repo; or fine-grained equivalent)
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Optional: Clone protocol (https or ssh)
GITFLEET_PROTOCOL=https

# Optional: Workspace directory (defaults to current directory)
GITFLEET_WORKSPACE=.

# Optional: Max concurrent clones, 1-20 (defaults to 5)
GITFLEET_CONCURRENCY=5

# Optional: Retries per repo for transient failures, 0-5 (defaults to 2)
GITFLEET_RETRIES=2

# Optional: Per-operation git timeout in ms (defaults to 300000)
GITFLEET_TIMEOUT=300000

# Optional: Terminal theme (auto, dark, light; defaults to auto)
GITFLEET_THEME=auto

# Optional: Comma-separated org/repo filters (non-interactive mode)
# GITFLEET_ORGS=my-org,other-org
# GITFLEET_REPOS=repo-a,repo-b
